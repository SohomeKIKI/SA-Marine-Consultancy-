# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=batchcrm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/batchcrm

# Security and JWT
# Use strong random secrets in production
JWT_SECRET_KEY=dev_jwt_secret_key_needs_to_be_at_least_32_bytes_long_12345
REFRESH_SECRET_KEY=dev_refresh_secret_key_needs_to_be_at_least_32_bytes_long_67890
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=false
COOKIE_SAMESITE=lax

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Initial Admin Seed
FIRST_ADMIN_NAME=System Administrator
FIRST_ADMIN_EMAIL=admin@batchcrm.com
FIRST_ADMIN_PASSWORD=AdminPassword123!
